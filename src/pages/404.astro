---
/** Ported from `_pages/404.html`. Astro emits this route as `/404.html`. */
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="404" showHeading={false} indexed={false}>
  <div class="not-found">
    <h1>404</h1>
    <p><strong>Page not found :(</strong></p>
    <p>The requested page could not be found.</p>
  </div>
</PageLayout>
