---
/**
 * The page shell: <head>, SEO and Open Graph meta, site nav, site footer,
 * analytics. Replaces `jekyll-seo-tag` plus the Primer, FontAwesome, KaTeX and
 * MathJax CDN links the Jekyll head loaded.
 */
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  /** Meta description and OG description. Falls back to the site blurb. */
  description?: string;
  /** `article` for posts, `website` otherwise. */
  ogType?: 'website' | 'article';
  /** Publication date, for `article:published_time`. */
  publishedDate?: Date;
}

const {
  title,
  description = 'Posts on statistics, machine learning and data analysis by David Recio.',
  ogType = 'website',
  publishedDate,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

const GA_MEASUREMENT_ID = 'G-J4ZRL7L1T1';
const siteTitle = "David Recio's Blog";
const pageTitle = title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;

const navLinks = [
  { href: '/about/', label: 'About Me' },
  { href: '/contact/', label: 'Contact' },
  { href: '/search/', label: 'Search' },
];

const socialLinks = [
  { href: 'https://github.com/recmit', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/david-recio-mitter', label: 'LinkedIn' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="David Recio" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteTitle}
      href={new URL('/feed.xml', Astro.site)}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    {
      publishedDate && (
        <meta property="article:published_time" content={publishedDate.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" rel="author" href="/">{siteTitle}</a>
      <nav class="site-nav">
        {navLinks.map(({ href, label }) => <a class="page-link" href={href}>{label}</a>)}
      </nav>
    </header>

    <main class="page-content">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="feed-subscribe"><a href="/feed.xml">Subscribe</a></p>
      <ul class="social-media-list">
        {
          socialLinks.map(({ href, label }) => (
            <li>
              <a rel="me" href={href}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </footer>
  </body>
</html>
